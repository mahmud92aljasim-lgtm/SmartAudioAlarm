<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#040914"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="350dp">

        <!-- الدائرة المركزية الكبيرة -->
        <FrameLayout
            android:id="@+id/centerHudContainer"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_centerInParent="true">

            <com.example.smartaudioalarm.HudClockView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <!-- الوقت مع الثواني بترتيب صحيح -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:layoutDirection="ltr"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMainTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:shadowColor="#00F0FF"
                        android:shadowRadius="15"
                        android:text="12:00 PM"
                        android:textColor="#00F0FF"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSeconds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFamily="monospace"
                        android:text=":00"
                        android:textColor="#80F8FF"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- التاريخ أسفل الوقت -->
                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="2026-11-26"
                    android:textColor="#B2EBF2"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- دائرة 1 (أعلى اليمين/اليسار): عدد المنبهات النشطة -->
        <LinearLayout
            android:id="@+id/nodeStatus"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="4dp"
            android:background="@drawable/bg_hud_node"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActiveCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0"
                android:textColor="#00F0FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="منبهات"
                android:textColor="#80F8FF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- دائرة 2 (أعلى المقابل): زر الإعدادات -->
        <LinearLayout
            android:id="@+id/btnHudSettings"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="4dp"
            android:background="@drawable/bg_hud_node"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textColor="#00F0FF"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ضبط"
                android:textColor="#80F8FF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- دائرة 3 (أسفل المقابل): مؤشر المنبه القادم -->
        <LinearLayout
            android:id="@+id/nodeNextAlarm"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="4dp"
            android:background="@drawable/bg_hud_node"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNextAlarmTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="--:--"
                android:textColor="#00F0FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="القادم"
                android:textColor="#80F8FF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- دائرة 4 (أسفل): زر إضافة منبه جديد -->
        <LinearLayout
            android:id="@+id/fabAddAlarm"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="4dp"
            android:background="@drawable/bg_hud_node"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#00F0FF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إضافة"
                android:textColor="#80F8FF"
                android:textSize="10sp" />
        </LinearLayout>

    </RelativeLayout>

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="لا توجد منبهات نشطة • اضغط على دائرة الإضافة"
        android:textColor="#4DD0E1"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAlarms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp" />

</LinearLayout>
